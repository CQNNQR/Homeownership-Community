# WordPress Site URL (without trailing slash)
# Replace with your actual WordPress site URL
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.com

# Supabase (client, exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-side only, bypasses RLS)
# Required for admin server-side reads. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email for /api/contact and /api/subscribe)
RESEND_API_KEY=your-resend-api-key

# Public site URL (used in email footers)
NEXT_PUBLIC_SITE_URL=https://thehomeownershipcommunity.com

# Comma-separated allowlist of admin emails. When a user on this list
# logs in, /api/auth/check will self-heal app_metadata.role = 'admin'
# (via SUPABASE_SERVICE_ROLE_KEY) if the JWT lacks the claim. This
# prevents the "can't log in" loop when an admin's role is missing.
ADMIN_EMAILS=admin@hoc.com
