# WordPress Site URL (without trailing slash)
# Replace with your actual WordPress site URL
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.com

# Supabase (client, exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-side only, bypasses RLS)
# Required for admin server-side reads. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email for /api/contact and /api/subscribe)
RESEND_API_KEY=your-resend-api-key

# Public site URL (used in email footers)
NEXT_PUBLIC_SITE_URL=https://thehomeownershipcommunity.com

# Comma-separated allowlist of admin emails. When a user on this list
# logs in, /api/auth/check will self-heal app_metadata.role = 'admin'
# (via SUPABASE_SERVICE_ROLE_KEY) if the JWT lacks the claim. This
# prevents the "can't log in" loop when an admin's role is missing.
ADMIN_EMAILS=admin@hoc.com

# --- Backend Recovery Plan additions ---

# Zapier webhook URL. Server-only. Replaces the previous public site
# setting. Used by /api/leads and the dispatcher cron.
ZAPIER_WEBHOOK_URL=

# Contact form sender (verified domain in Resend) and recipient.
CONTACT_FROM_EMAIL=The Homeownership Community <onboarding@resend.dev>
CONTACT_TO_EMAIL=brandon@hocmortgage.com

# Per-IP rate limit for /api/contact. Defaults to 20 if unset.
LEAD_RATE_LIMIT_PER_HOUR=20

# Shared secret expected in the Authorization: Bearer header of
# Vercel Cron requests to /api/admin/integrations/zapier/dispatch.
# Leave unset in development; the endpoint then refuses cron calls.
CRON_SECRET=

# Playwright / E2E admin credentials. Replaces the hardcoded
# `admin@hoc.com / !Texas1995` that used to be checked into tests
# and roadmap docs. The prebuild script and Playwright suites all
# read these env vars.
E2E_ADMIN_EMAIL=admin@hoc.com
E2E_ADMIN_PASSWORD=!Texas1995
